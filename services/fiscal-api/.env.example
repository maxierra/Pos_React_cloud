PORT=3099
# Misma clave que FISCAL_API_KEY en el .env raíz de Next.js
FISCAL_API_KEY=dev-fiscal-api-key-change-me
# Mismo proyecto Supabase que NEXT_PUBLIC_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY del .env raíz
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Opcional: token de https://afipsdk.com si tu plan lo requiere (no es la clave privada ARCA)
AFIP_SDK_ACCESS_TOKEN=
# La clave privada y el CSR se generan en runtime y se guardan en el bucket fiscal-certs.
# No configures archivos .key ni .crt en variables de entorno.
